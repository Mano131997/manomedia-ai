# Database (SQLite to start; for Postgres change provider in prisma/schema.prisma)
DATABASE_URL="file:./studio.db"

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=""

# Where uploads and generated files are stored
STORAGE_DIR="./storage"

# Higgsfield API key for image/video models (https://cloud.higgsfield.ai -> API keys).
# Format: KEY_ID:KEY_SECRET
HF_KEY=""

# Optional: fal.ai key for the extra fal models (https://fal.ai/dashboard/keys).
FAL_KEY=""

# With neither HF_KEY nor FAL_KEY the app runs in demo mode (placeholder images, no video).

# Claude API key for the chat studio (https://platform.claude.com)
ANTHROPIC_API_KEY=""
